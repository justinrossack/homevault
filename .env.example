# Kopieren nach .env und anpassen.
# Alles Weitere (Admin, Benutzer, Servername) richtest du beim ersten
# Aufruf im Browser ein.

# Ordner auf dem Server. Darin entstehen "Gemeinsam/", "Privat/<benutzer>/"
# und ".homevault/" (Datenbank).
MEDIA_DIR=/srv/homevault

# Besitzer der Dateien im MEDIA_DIR (auf dem Server: `id -u` und `id -g`)
PUID=1000
PGID=1000

# Gruppe „render“ des Servers für Intel Quick Sync (Video-Umwandlung in
# Hardware): `getent group render | cut -d: -f3`
#RENDER_GID=992

# Ports auf dem Server
WEB_PORT=8080
SMB_PORT=445

# --- Optional: Festplatten-Verwaltung (Spiegel/RAID, Hot-Swap) ---
# Damit homevault Festplatten zu einem Spiegel zusammenfassen und im
# laufenden Betrieb tauschen kann. Die Zeilen unten einkommentieren und ein
# eigenes, langes Token eintragen (z. B. `openssl rand -hex 24`).
# MEDIA_DIR muss dann ein (leerer) Ordner auf der Systemplatte sein, z. B. /srv/homevault.
#COMPOSE_PROFILES=disks
#MEDIA_PROPAGATION=rslave
#DISK_AGENT_URL=http://disks:8091
#DISK_AGENT_TOKEN=

# --- Optional: KI für den Eingangs-Ordner ---
# Dokumente, die in „Eingang“ landen, benennt und sortiert eine lokale KI
# (nichts verlässt das Haus). Fotos werden auch ohne KI nach Datum/Ort sortiert.
# Einschalten: bei COMPOSE_PROFILES „ai“ ergänzen (z. B. „disks,ai“ oder nur
# „ai“) und AI_URL einkommentieren. Braucht ca. 4 GB RAM und 5 GB Platz.
#AI_URL=http://ai:11434
# Kleiner und schneller, aber ungenauer: qwen2.5:1.5b
#AI_MODEL=qwen2.5:3b
